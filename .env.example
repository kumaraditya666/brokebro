# BrokeBro — env template (copy to .env.local)
# App runs local-first without these. Add them to enable cloud auth/sync + server AI.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: server-side LLM for Money Coach (never prefix with NEXT_PUBLIC_)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Optional: Jamendo catalog (free client_id from https://developer.jamendo.com).
# Without it, BROKE MUSIC uses the bundled playable demo catalog + local files.
NEXT_PUBLIC_JAMENDO_CLIENT_ID=

# UPI screenshot import: server vision/OCR is used only if you wire a provider.
# Until then the app uses on-device OCR. Set this to "true" ONLY for local UI testing
# with clearly-labeled mock extractions — never in production.
ALLOW_DEMO_OCR=false
ENABLE_DEMO_OCR=false
