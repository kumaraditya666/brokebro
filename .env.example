# BrokeBro — env template (copy to .env.local)
# App runs local-first without these. Add them to enable cloud auth/sync + server AI.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: server-side LLM for Money Coach (never prefix with NEXT_PUBLIC_)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
